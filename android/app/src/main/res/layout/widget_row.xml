<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Zeile: Farbstreifen, Titel, darunter Tag/Uhrzeit; rechts (nur Gewohnheiten) der Haken.
     Beim Tippen auf eine Gewohnheit wächst der Kreis kurz und bekommt einen Splash. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/bar"
        android:layout_width="4dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_sub"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/mark"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/widget_mark_ripple"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:stateListAnimator="@animator/widget_mark_press"
        android:visibility="gone" />
</LinearLayout>
